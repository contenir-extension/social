{
    "name": "contenir-extension/social",
    "description": "The Social add-on for Contenir CMS: profile links for twelve networks, checked as they are saved, and share buttons chosen and ordered by editors. It replaces the CMS's Social Media Links plugin, with the same settings keys.",
    "type": "contenir-extension",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "contenir-extension",
        "social",
        "share",
        "social-links"
    ],
    "support": {
        "issues": "https://github.com/contenir-extension/social/issues",
        "source": "https://github.com/contenir-extension/social"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/extension-api": "^0.5",
        "contenir/contenir-social": "^0.1"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "nyholm/psr7": "^1.8.2",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Extension\\Social\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Extension\\Social\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "boundary": "extension-boundary",
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint",
            "mago guard"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "extra": {
        "contenir": {
            "handle": "social",
            "extension": "Contenir\\Extension\\Social\\SocialExtension"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/contenir/contenir-social"
        }
    ]
}
